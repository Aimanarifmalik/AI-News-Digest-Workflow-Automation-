      "id": "b2257e21-5e6b-4c19-9858-436fb0cbe32d",
      "name": "Limit to 5 Articles",
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [
        784,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "// Turn the list of separate RSS items into ONE text block,\n// because the AI needs one combined prompt, not many separate items.\nconst items = $input.all();\nlet combined = \"\";\nfor (const item of items) {\n  const title = item.json.title || \"\";\n  const link = item.json.link || \"\";\n  combined += `- ${title} (${link})\\n`;\n}\nreturn [{ json: { articles_text: combined } }];"
      },
      "id": "4b97cb87-dfde-4a3c-967a-24fe805ba4ee",
      "name": "Combine Articles Into Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1008,
        160
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: \"openai/gpt-oss-20b\",\n  messages: [\n    { role: \"system\", content: \"You are a tech news editor. Turn this list of headlines into a short daily digest: for each one, write a 1-2 sentence plain-English summary of what it's likely about based on the title. Keep it concise.\" },\n    { role: \"user\", content: $json.articles_text }\n  ]\n}) }}",
        "options": {}
      },
      "id": "10fd0634-7948-49ea-9cc3-1970c3aebefd",
      "name": "Summarize With Groq AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1216,
        160
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "g2WFERRx4Maz3Dgd",
          "name": "Header Auth account 4"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Groq's response is a big JSON object. We only want the actual\n// written text it generated, which lives at choices[0].message.content.\nconst response = $input.first().json;\nconst digestText = response.choices[0].message.content;\nreturn [{ json: { digest: digestText } }];"
      },
      "id": "c9848d75-bb1d-4e57-bff6-0fdbcf0fba42",
      "name": "Extract Digest Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        160
      ]
    }
